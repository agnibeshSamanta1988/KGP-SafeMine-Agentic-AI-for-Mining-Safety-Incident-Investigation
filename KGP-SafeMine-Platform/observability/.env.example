# Copy to observability/.env and replace every CHANGE_ME with a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(24))"
# observability/.env is private: it is git-ignored, never commit it.
# Used by docker-compose.yml (Langfuse v2, legacy) and docker-compose.v3.yml (Langfuse v4 stack, works with the langfuse 5.x SDK).
POSTGRES_PASSWORD=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME          # v3 stack only: 64 hex characters (python -c "import secrets; print(secrets.token_hex(32))")
CLICKHOUSE_PASSWORD=CHANGE_ME     # v3 stack only
MINIO_ROOT_PASSWORD=CHANGE_ME     # v3 stack only
REDIS_AUTH=CHANGE_ME              # v3 stack only
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME
# NEXTAUTH_URL=http://localhost:3000    # v3 stack: set to your public URL when served behind a proxy
