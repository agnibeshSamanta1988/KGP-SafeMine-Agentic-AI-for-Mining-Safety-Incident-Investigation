# Copy to .env (never commit .env). Switch models with LLM_PROVIDER.
#   upgrad = the Track B hosted Qwen3-8B endpoint (OpenAI-compatible; the code's default provider name)
#   groq   = Groq free tier, openai/gpt-oss-20b -> dev/testing only (1,000 req/day; 20B is above the 8B cap)
LLM_PROVIDER=groq

# ---- Hosted Qwen3-8B (Track B) endpoint: set the port and CA certificate your provider gives you ----
UPGRAD_BASE_URL=https://YOUR_ENDPOINT_HOST:PORT/v1
UPGRAD_API_KEY=sk-REPLACE_ME
UPGRAD_MODEL=Qwen/Qwen3-8B
UPGRAD_CA_CERT=certs/llm-ca.crt

# ---- Groq (testing) ----
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# ---- Optional hosted models (not part of the graded Track B system) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_TEMPERATURE=0.1

# Pause between LLM calls to stay under free-tier rate limits (Groq: 30 req/min). Also switchable in the UI.
LLM_SLEEP_ENABLED=true
LLM_SLEEP_SECONDS=2.0

# Disable model "thinking" (Qwen3 /no_think; gpt-oss low reasoning effort) for short, valid JSON
LLM_DISABLE_THINKING=true

# ---- Embeddings ----
# endpoint = shared capstone embedding API (bge-small-en-v1.5, 384-d, <=16 texts/request)
# local    = models/bge-small-en-v1.5 on CPU (same model, offline fallback)
EMBED_BACKEND=endpoint
EMBED_BASE_URL=https://YOUR_EMBEDDING_HOST:PORT/v1
EMBED_API_KEY=sk-REPLACE_WITH_SHARED_EMBEDDING_KEY
EMBED_MODEL=bge-small-en-v1.5
EMBED_CA_CERT=certs/embed-ca.crt
RERANK_MODE=fuse

# ---- Limits (Track B guardrails) ----
MAX_STEPS=10
MAX_REVISIONS=2
TOKEN_BUDGET_PER_QUERY=12000

# ---- Langfuse tracing (leave the keys empty to disable) ----
# Team dashboard: Langfuse Cloud. Project settings -> API Keys -> create; paste both keys here.
#   LANGFUSE_HOST=https://cloud.langfuse.com      (EU region)   or   https://us.cloud.langfuse.com   (US region)
# Self-hosted alternative (needs Docker): observability/docker-compose.yml, then LANGFUSE_HOST=http://localhost:3000
# Check:  .venv/bin/python -m safemine.tracing   -> 'reachable': True, 'auth': True
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Data and model folders (relative to this folder) ----
# In a clone of the repository the dataset is the sibling folder KGP-SafeMine-Data.
SAFEMINE_DATA=../KGP-SafeMine-Data
# SAFEMINE_OUT=data_processed
# SAFEMINE_MODELS=models

# ---- Optional switches (defaults shown) ----
# AGENT_MODE=multi
# AGENT_DEADLINE_S=420
# AGENT_STRICT_GROUNDING=false
# AGENT_GROUNDING_MIN=0.35
# API_LLM_PROVIDER=
# EMBED_ALLOW_HF_DOWNLOAD=false
# LANGFUSE_ENABLED=true
