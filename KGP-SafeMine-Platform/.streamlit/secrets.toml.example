# Copy to .streamlit/secrets.toml and fill in. The real file is git-ignored.
[auth]
username = "admin"
password_hash = 'PASTE_BCRYPT_HASH_HERE'   # python -m app.make_password_hash
timeout_minutes = 30    # inactivity timeout
max_attempts = 5        # failed logins before a lock-out
lock_minutes = 5        # lock-out length
